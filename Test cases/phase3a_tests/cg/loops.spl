#i #s : : #i = 0 ; #s = 0 ;
while lesser ( #i 5 ) do { #s = add ( #s #i ) ; #i = add ( #i 1 ) ; } ;
print ( #s ) ; print "," ;
#i = 0 ;
until eq ( #i 3 ) do { print ( #i ) ; #i = add ( #i 1 ) ; } ;
print "," ;
do { #i = sub ( #i 1 ) ; print ( #i ) ; } while larger ( #i 0 ) ;
print "," ;
#i = 10 ;
do { print ( #i ) ; #i = add ( #i 1 ) ; } until larger ( #i 11 ) ;
print "," ;
#i = 0 ;
while and ( lesser ( #i 10 ) not ( eq ( #i 3 ) ) ) do { #i = add ( #i 1 ) ; } ;
print ( #i ) ;
